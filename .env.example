# --- Existing Variables ---
# Your comma-separated list of OpenRouter API keys (can be a single key)
OPENROUTER_API_KEY="your_openrouter_key_1,your_openrouter_key_2"
# The secret key required to authorize with this proxy API
PROXY_AUTH_KEY="your_secret_proxy_key"

# --- New Variables for Dynamic Tiering ---
# The small, fast model used to route requests
ROUTER_MODEL="openai/gpt-4o-mini"

# The "menu" of models the router can choose from.
# This MUST be a valid JSON string with no newlines.
ROUTER_MODEL_PALETTE="[{"model_name": "openai/gpt-4o-mini", "description": "Very fast & cheap. Best for super simple questions, classification, or simple summarization."}, {"model_name": "openai/gpt-4o", "description": "Fast & balanced. Good for medium-level questions and general conversation."}, {"model_name": "google/gemini-2.5-pro", "description": "Most powerful & expensive. For very complex questions requiring deep, nuanced reasoning."}]"

# The default model for the -pro tier and for the synthesizer if the router fails
OPENROUTER_MODEL_NAME="google/gemini-2.5-pro"
