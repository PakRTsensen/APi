# --- Existing Variables ---
# Your comma-separated list of OpenRouter API keys (can be a single key)
OPENROUTER_API_KEY="your_openrouter_key_1,your_openrouter_key_2"
# The secret key required to authorize with this proxy API
PROXY_AUTH_KEY="your_secret_proxy_key"
# The base URL for the OpenAI compatible API
OPENAI_BASE_URL="https://openrouter.ai/api/v1"

# --- Variables for Dynamic Tiering ---
# The small, fast model used to route requests
ROUTER_MODEL="x-ai/grok-4-fast:free"

# The "menu" of models the router can choose from.
ROUTER_MODEL_PALETTE='[{"model_name": "x-ai/grok-4-fast:free", "description": "Fast router model, good for simple tasks and classification."}, {"model_name": "google/gemini-2.5-flash-lite", "description": "Very fast and lightweight model from Google, for simple and quick tasks."}, {"model_name": "nvidia/nemotron-nano-9b-v2:free", "description": "Small and efficient model for general tasks."}, {"model_name": "deepseek/deepseek-chat-v3.1:free", "description": "Capable chat model for conversation and instruction following."}, {"model_name": "tngtech/deepseek-r1t-chimera:free", "description": "Advanced research model with strong reasoning capabilities."}, {"model_name": "google/gemini-2.5-flash", "description": "Fast and multimodal model from Google, good balance of speed and capability."}, {"model_name": "openai/gpt-oss-20b:free", "description": "Large open-source model, good for general knowledge and reasoning."}, {"model_name": "qwen/qwen3-coder:free", "description": "Specialized model for code generation and software development tasks."}, {"model_name": "qwen/qwen3-235b-a22b:free", "description": "Very large, powerful model for complex and deep reasoning. High cost."}, {"model_name": "google/gemini-2.5-pro", "description": "Most powerful model for complex, deep, and nuanced questions requiring expert-level analysis."}]'

# The default model for the -pro tier and for the synthesizer if the router fails
OPENROUTER_MODEL_NAME="google/gemini-2.5-pro"